{
    admin off
    storage file_system ./data/caddy
    default_sni 203.0.113.10
}

https://203.0.113.10 {
    tls {
        issuer acme https://acme-v02.api.letsencrypt.org/directory {
            profile shortlived
        }
    }
    request_body {
        max_size 64KB
    }
    reverse_proxy 127.0.0.1:21114
}
